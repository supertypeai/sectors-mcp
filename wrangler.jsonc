/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sectors-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// The MCP transport is now stateless (no Durable Object). The v1 migration
	// created the SQLite-backed MyMCP DO; the v2 migration deletes it so
	// Cloudflare tears down the existing namespace. Do not remove the v1 entry —
	// migrations are a cumulative, ordered log.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MyMCP"
			]
		},
		{
			"tag": "v2",
			"deleted_classes": [
				"MyMCP"
			]
		}
	],
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "2fee5d32c06d42d1a4f69a45f8bb59eb"
		}
	]
}